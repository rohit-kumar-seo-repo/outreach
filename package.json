{
  "name": "rks-outreach-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Rohit Kumar SEO Outreach — private outreach tracking dashboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/index.ts src/cli/migrate.ts src/cli/hash-password.ts src/cli/seed-preview.ts src/cli/totp-setup.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --packages=external --tsconfig=tsconfig.json --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "hash-password": "tsx src/cli/hash-password.ts",
    "totp-setup": "tsx src/cli/totp-setup.ts",
    "seed:preview": "tsx src/cli/seed-preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "imapflow": "2.1.2",
    "lucide-react": "1.48.0",
    "mailparser": "3.9.31",
    "motion": "^14.0.0",
    "next": "16.3.7",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
