# Example settings for local development or the plain deploy/docker-compose.yml stack.
# Copy to deploy/.env (or .env.local for `npm run dev`), fill in, and never commit the copy.
# On the Hostinger VPS, set these in hPanel → Docker Manager → outreach → Environment instead.

POSTGRES_PASSWORD=
# DATABASE_URL is built from POSTGRES_PASSWORD by docker compose; set it only for local runs:
# DATABASE_URL=postgres://outreach:<password>@localhost:5432/outreach
APP_TIMEZONE=Asia/Kolkata
PUBLIC_URL=https://outreach.rohitkumarseo.com

# Login: set ADMIN_PASSWORD (12+ chars) or ADMIN_PASSWORD_HASH (npm run hash-password).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Optional two-factor login (npm run totp-setup)
ADMIN_TOTP_SECRET=
SESSION_TTL_HOURS=12

# n8n execution history (n8n → Settings → n8n API)
N8N_BASE_URL=
N8N_API_KEY=
# Read-only sheet bridge: <n8n URL>/webhook/outreach-dashboard-bridge + its Header Auth value
N8N_BRIDGE_URL=
N8N_BRIDGE_KEY=
# Optional push endpoint /api/ingest/n8n
INGEST_KEY=

# Mailboxes: Hostinger Email API tokens (comma-separated, one per mail order) and/or IMAP accounts
HOSTINGER_MAIL_TOKENS=
IMAP_ACCOUNTS_JSON=
MAIL_INITIAL_SYNC_DAYS=120

# WhatsApp (WAHA)
WAHA_BASE_URL=
WAHA_API_KEY=

# Backups (backup container)
BACKUP_AT=02:30
BACKUP_RETENTION_DAYS=14
