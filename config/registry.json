    {
      "key": "gads_outreach_sheet",
      "kind": "google_sheet",
      "name": "Google Ads International Outreach Sheet",
      "channel": "email",
      "rowKey": [
        "LeadID",
        "Email"
      ],
      "campaign": {
        "rules": [
          {
            "column": "LeadID",
            "regex": "^seo-",
            "campaign": "seo-visibility-us"
          },
          {
            "column": "LeadID",
            "regex": "gads",
            "campaign": "google-ads-services-intl"
          }
        ],
        "default": "google-ads-services-intl"
      },
      "columns": {
        "name": [
          "Business"
        ],
        "email": [
          "Email"
        ],
        "phone": [
          "Phone"
        ],
        "city": [
          "City"
        ],
        "category": [
          "Vertical"
        ],
        "status": "Status",
        "scheduledAt": "ScheduledSendISO",
        "sender": "Send-from mailbox",
        "subject": "Subject",
        "draft": "Subject"
      },
      "blankStatus": "new",
      "statusRules": [
        {
          "match": "\\bbounced\\b",
          "state": "bounced"
        },
        {
          "match": "^approved$",
          "state": "queued"
        },
        {
          "match": "^sent\\b",
          "state": "sent"
        },
        {
          "match": "^send failed",
          "state": "failed"
        },
        {
          "match": "^(drafted|draft|awaiting|pending)",
          "state": "awaiting_approval"
        },
        {
          "match": "^repl",
          "state": "replied"
        },
        {
          "match": "^(do not contact|dnc|unsub|opt.?out|skip|excluded|invalid|bounced|rejected)",
          "state": "excluded"
        },
        {
          "match": "^call list",
          "state": "excluded"
        }
      ],
      "history": "status_sent_iso",
      "touchRows": {
        "column": "LeadID",
        "pattern": "^(.*)-fu(\\d+)$"
      },
      "omitColumns": [
        "TextBody",
        "HTMLBody",
        "errorStack"
      ]
    },
